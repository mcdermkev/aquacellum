# Environment — NEVER commit private keys
.env
.env.*
!.env.example

# Google Cloud service account keys — NEVER commit
aquacellum-*.json
*-service-account*.json
*serviceaccount*.json
gcp-*.json
google-credentials*.json

# Hardhat
cache/
artifacts/
deployed-addresses-*.json

# Node
node_modules/

# Python
.venv/
__pycache__/
*.pyc

# Build output
dist/
frontend/dist/

# Generated lint/report artifacts
frontend/eslint-report.json
eslint-report.json

# Logs
*.log
migration_errors.log

# Vercel
.vercel/
**/.vercel/

# IDE / Editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# One-time migration data (large binaries, not app source)
migration_assets/
local_data/

# Kiro internal
.kiro/

# Docs — internal planning, keep off GitHub (except XR architecture)
docs/
!docs/IMMERSIVE_REEF_ARCHITECTURE.md

# Frontend scripts — internal tooling (image gen, cutouts, etc.)
#
# `/*` rather than `/` so git still DESCENDS into the directory; with a trailing
# slash it refuses to look inside and the negation below can never match.
frontend/scripts/*
# Exception: the seam analyzer is a CI dependency, not local tooling —
# src/__tests__/seamInventory.test.js imports it, so the suite cannot run without it.
!frontend/scripts/seams/
#
# NOTE: anything that must survive a fresh clone belongs in `frontend/ops/`, not
# here. That directory is tracked precisely because this one is not — see
# frontend/ops/README.md.

# Supabase CLI local cache. `.temp/cli-latest` just records the CLI version the
# machine last saw, so it churns for every developer on a different version and
# says nothing about the project. It was tracked by accident.
supabase/.temp/

# Review artefacts — inputs and outputs of review passes, not app source.
# img_review/ in particular is several MB of species photos; binaries cannot be
# diffed and stay in history permanently once committed.
img_review/
semantic-review/

# FishBase data extraction (large parquet files, intermediate data)
*.parquet
fishbase_verified_data.json
seriously_fish_data.json
frontend/public/fishbase_master_proposed_backup.json
frontend/public/fishbase_master_proposed_v2.json

# Video pipeline — generated audio & voice samples (JSON scripts stay tracked)
scripts/video/samples/
scripts/video/out/audio/
# Screen captures too: same reasoning as img_review/ above — a .webm cannot be
# diffed and stays in history permanently once committed. The capture for one
# episode alone is 3.65 MB, and these are regenerable from the shot list.
scripts/video/out/capture/
