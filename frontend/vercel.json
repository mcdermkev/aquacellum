{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "includeFiles": "public/fishbase_master.json"
    }
  },
  "crons": [
    { "path": "/api/stripe?action=auto-release", "schedule": "0 9 * * *" }
  ],
  "redirects": [
    { "source": "/tanks", "destination": "/app/tanks", "permanent": false },
    { "source": "/breeder-tools", "destination": "/app/breeder", "permanent": false },
    { "source": "/orders", "destination": "/app/orders", "permanent": false },
    { "source": "/incoming", "destination": "/app/incoming", "permanent": false },
    { "source": "/my-store", "destination": "/app/storefront", "permanent": false },
    { "source": "/settings", "destination": "/app/settings", "permanent": false },
    { "source": "/reef-social", "destination": "/app/reef", "permanent": false }
  ],
  "rewrites": [
    { "source": "/checkout/success", "destination": "/checkout-success.html" },
    { "source": "/store/:path*", "destination": "/store.html" },
    { "source": "/species/:path*", "destination": "/species.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/:path*", "destination": "/app.html" },
    { "source": "/hobbyist", "destination": "/hobbyist.html" },
    { "source": "/breeder", "destination": "/breeder.html" },
    { "source": "/database", "destination": "/database.html" },
    { "source": "/marketplace", "destination": "/marketplace.html" },
    { "source": "/reef", "destination": "/reef.html" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/breeders", "destination": "/breeders.html" },
    { "source": "/breeds", "destination": "/breeds.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/legal", "destination": "/legal.html" },
    { "source": "/developers", "destination": "/developers.html" },
    { "source": "/poseidon", "destination": "/poseidon.html" },
    { "source": "/leaderboard", "destination": "/leaderboard.html" }
  ]
}


