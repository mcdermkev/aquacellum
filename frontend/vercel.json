{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/showcase/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://stream.mux.com https://yahsdztnvsykzecjatsl.supabase.co; media-src 'self' https://stream.mux.com blob:; worker-src 'self' blob:"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "public/fishbase_master.json"
    }
  },
  "crons": [
    { "path": "/api/stripe?action=auto-release", "schedule": "0 9 * * *" },
    { "path": "/api/retention", "schedule": "0 15 * * *" },
    { "path": "/api/retention?action=weekly-digest", "schedule": "30 10 * * 0" },
    { "path": "/api/stripe?action=auction-sweep", "schedule": "15 8 * * *" },
    { "path": "/api/retention?action=purge-deletions", "schedule": "45 7 * * *" }
  ],
  "redirects": [
    { "source": "/tanks", "destination": "/app/tanks", "permanent": false },
    { "source": "/breeder-tools", "destination": "/app/breeder", "permanent": false },
    { "source": "/orders", "destination": "/app/orders", "permanent": false },
    { "source": "/incoming", "destination": "/app/incoming", "permanent": false },
    { "source": "/my-store", "destination": "/app/breeder-terminal", "permanent": false },
    { "source": "/settings", "destination": "/app/settings", "permanent": false },
    { "source": "/reef-social", "destination": "/app/reef", "permanent": false },
    { "source": "/auctions", "destination": "/app/auctions", "permanent": false },
    { "source": "/auctions/:id", "destination": "/app/auctions/:id", "permanent": false },
    { "source": "/hobbyist", "destination": "/", "permanent": true },
    { "source": "/hobbyist.html", "destination": "/", "permanent": true },
    { "source": "/breeder", "destination": "/app/directory", "permanent": true },
    { "source": "/breeder.html", "destination": "/app/directory", "permanent": true },
    { "source": "/reef", "destination": "/app/reef", "permanent": true },
    { "source": "/reef.html", "destination": "/app/reef", "permanent": true }
  ],
  "rewrites": [
    { "source": "/showcase-media/:path*", "destination": "https://yahsdztnvsykzecjatsl.supabase.co/storage/v1/object/public/showcase-public/:path*" },
    { "source": "/api/showcase-media/:assetId/:variant", "destination": "/api/storefront-detail?action=showcase-media&asset=:assetId&variant=:variant" },
    { "source": "/showcase/:path*", "destination": "/showcase.html" },
    { "source": "/checkout/success", "destination": "/checkout-success.html" },
    { "source": "/store/:path*", "destination": "/store.html" },
    { "source": "/species/:path*", "destination": "/species.html" },
    { "source": "/t/:path*", "destination": "/tank.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/:path*", "destination": "/app.html" },
    { "source": "/database", "destination": "/database.html" },
    { "source": "/marketplace", "destination": "/marketplace.html" },
    { "source": "/medaka-morphs", "destination": "/medaka-morphs.html" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/breeders", "destination": "/breeders.html" },
    { "source": "/clubs", "destination": "/clubs.html" },
    { "source": "/clubs/:slug", "destination": "/club.html" },
    { "source": "/breeds", "destination": "/breeds.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/legal", "destination": "/legal.html" },
    { "source": "/developers", "destination": "/developers.html" },
    { "source": "/poseidon", "destination": "/poseidon.html" },
    { "source": "/leaderboard", "destination": "/leaderboard.html" }
  ]
}


