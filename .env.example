# =============================================================================
# Aquadex Protocol — Environment Configuration
# TESTNET DEPLOYMENT: Base Sepolia (Chain ID: 84532)
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# --- Deployer Wallet ---
# Export from MetaMask: Account Details → Export Private Key
PRIVATE_KEY=your_private_key_here

# --- RPC Endpoint ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Block Explorer Verification ---
# Get a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Frontend (Vite) ---
# These are exposed to the browser bundle (VITE_ prefix)
VITE_MANAGER_ADDRESS=0x351ca8f34D94F29F6f865Afa419A636324473DeF
VITE_MARKETPLACE_ADDRESS=0x0741D50d49e7374b855b532c17aD36aBF8AF3b3e
VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org
VITE_BLOCK_EXPLORER=https://sepolia.basescan.org
VITE_PRIVY_APP_ID=your_privy_app_id_here

# --- PostHog (Product Analytics) ---
# Get your project API key: https://us.posthog.com/project/settings
VITE_POSTHOG_KEY=your_posthog_project_api_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Social Layer (The Reef) ---
# Supabase project: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Supabase Auth Bridge (Server-side only) ---
# Used by /api/mint-session to verify Privy access tokens. This must identify
# the same Privy application as VITE_PRIVY_APP_ID, but the server never falls
# back to the browser variable.
PRIVY_APP_ID=your_privy_app_id_here
# Used by /api/mint-session to sign Supabase-compatible JWTs.
# Find this in: Supabase Dashboard → Settings → API → JWT Secret
# This MUST match the secret Supabase uses to verify tokens.
# Server-side only (no VITE_ prefix) — NOT exposed to the browser.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# --- Fish Room owner API (Server-side only) ---
# Used by /api/showcase-owner for the wallet-link EIP-191 message (Domain/Origin) and CORS. One
# canonical origin: scheme + host + optional nondefault port, no path/query/fragment/trailing slash.
SHOWCASE_APP_ORIGIN=https://your-fish-room-origin.example
# The single canonical decimal chain ID Fish Room wallet links are bound to (e.g. 84532 for Base Sepolia).
SHOWCASE_CHAIN_ID=84532
# Curated publish rollout ("Steve first"). Comma-separated allowlist of owners permitted to publish a
# Room to a non-private visibility (public/unlisted). Each entry is either a verified Privy subject or a
# wallet address (matched case-insensitively). DEFAULT-CLOSED: if this is empty/unset, NOBODY can publish
# (browsing/owner editing still work; only going public is blocked). Taking a Room private is never gated.
# Add breeders here as the marketplace opens up — it's a config change, not a deploy.
SHOWCASE_PUBLISH_ALLOWLIST=0xsteve000000000000000000000000000000000000

# --- Poseidon AI Gateway (Vertex AI) ---
# Billed to the Google Cloud project below, so usage draws from project credits.
# Used server-side only (Vercel functions) — NOT exposed to the browser.
GCP_PROJECT_ID=aquacellum
GCP_LOCATION=us-central1
#
# Auth — choose ONE:
#  - Vercel: paste the FULL service-account JSON as a single line:
#      GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#  - Local: point to the key file instead (NEVER commit the file):
#      GOOGLE_APPLICATION_CREDENTIALS=C:\Users\you\.gcp\aquacellum-xxxx.json
GCP_SERVICE_ACCOUNT_JSON=

# --- Video & Livestream (Mux) ---
# Get credentials at https://dashboard.mux.com/settings/access-tokens
# Used server-side only (Vercel functions) — NOT exposed to the browser.
MUX_TOKEN_ID=your_mux_token_id_here
MUX_TOKEN_SECRET=your_mux_token_secret_here
MUX_WEBHOOK_SECRET=your_mux_webhook_signing_secret_here
# Separate Mux signing-key credentials created for signed playback (RS256 PKCS#8 private key).
MUX_SIGNING_KEY_ID=your_mux_signing_key_id_here
MUX_SIGNING_PRIVATE_KEY=base64_or_pem_pkcs8_private_key_here
# Default closed. Enable only after the reviewed migration, worker, strict webhook, and signing key are live.
SHOWCASE_VIDEO_ENABLED=false

# Frontend origin for Mux CORS (direct uploads)
FRONTEND_ORIGIN=https://aquadex.io

# --- Stripe Connect (Fiat Payments) ---
# Platform account keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Marketplace contract address (for fiat settlement relay)
MARKETPLACE_ADDRESS=0x0741D50d49e7374b855b532c17aD36aBF8AF3b3e
# Stripe Connect redirect URLs (seller onboarding completion)
STRIPE_CONNECT_RETURN_URL=https://aquadex.fish/seller/onboarding-complete
STRIPE_CONNECT_REFRESH_URL=https://aquadex.fish/seller/onboarding-refresh
# Checkout redirect URLs
CHECKOUT_SUCCESS_URL=https://aquadex.fish/checkout/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://aquadex.fish/marketplace

# --- Resend (Transactional & Retention Email) ---
# Get your API key at https://resend.com/api-keys
# RESEND_FROM_EMAIL must be a verified sending domain/address in Resend.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Aquacellum <notifications@aquacellum.com>
APP_URL=https://aquacellum.com

# --- Cron Secret (authorizes Vercel Cron requests to admin-only endpoints) ---
CRON_SECRET=your_random_cron_secret_here

# --- Feedback relay (Discord webhook for the in-app Feedback button) ---
# Server-side only (no VITE_ prefix). Read by api/_lib/feedbackRelay.js via
# /api/retention?action=feedback. Never put this in a VITE_ variable: Vite
# inlines those into the public JS bundle.
FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# --- Handoff Challenge Signing Secret (cash pickup two-party confirmation) ---
# HMAC secret used to sign/verify the one-time in-person cash-pickup handoff
# challenge (api/_lib/handoffChallenge.js). Server-side only. Use a long random
# value, e.g. `openssl rand -hex 32`.
HANDOFF_SIGNING_SECRET=your_random_handoff_secret_here

# --- ShipEngine (Live Shipping Rates + Labels) ---
# API key from https://dashboard.shipengine.com/api-management
# Used server-side only (Vercel functions) — NOT exposed to the browser.
SHIPENGINE_API_KEY=your_shipengine_api_key_here
# Flat platform handling fee (USD cents) added to every shipping quote on top of
# the carrier rate. Buyer pays carrier rate + this; platform keeps it as margin.
SHIPPING_HANDLING_FEE_CENTS=200
# Comma-separated ShipEngine carrier_ids to quote (find via GET /v1/carriers).
# Leave blank to quote ALL carriers connected to your ShipEngine account.
# Example: se-1234567,se-7654321
SHIPENGINE_CARRIER_IDS=
# Shared secret you set when creating the ShipEngine tracking webhook.
# Sent back to us as the last path segment / query param so we can verify
# inbound tracking callbacks are genuinely from ShipEngine.
SHIPENGINE_WEBHOOK_SECRET=your_shipengine_webhook_secret_here
# --- Fish Room private media pipeline (server-side only) ---
# Keep false until migration 20260830160000 is applied, both private buckets are verified,
# and the Azure Container Apps worker + dead-job alert are deployed.
SHOWCASE_MEDIA_ENABLED=false
# Supabase Storage S3 endpoint, e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
SHOWCASE_STORAGE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SHOWCASE_STORAGE_S3_REGION=your_supabase_s3_region
SHOWCASE_STORAGE_S3_ACCESS_KEY_ID=your_server_only_s3_access_key_id
SHOWCASE_STORAGE_S3_SECRET_ACCESS_KEY=your_server_only_s3_secret_access_key
